# Copy to .env in this repo root and fill in values.

# --- Required for real LLM runs ---
OPENAI_API_KEY=sk-...

# --- Optional: safety before using real Gmail (comma-separated) ---
# ALLOWLIST_SENDERS=mom@example.com,trusted@friend.com

# --- Optional: fake triager/drafter (or use CLI `inbox-agent run --fake-llm --dry-run`) ---
# FAKE_LLM=1

# --- Optional: use in-process `lookup_contact_history` for ReAct (no MCP subprocess) ---
# MCP_OFF=1
